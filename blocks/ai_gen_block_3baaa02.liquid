{% doc %}
  @prompt
    Create a layout section for a "Set Up" page that includes: a grid of video tutorial cards (each with an embedded video placeholder, a title, and a short description), followed by a numbered step-by-step instructions section where each step has a number, a heading, and a body text area. The layout should be clean and easy to scan, with clear visual separation between the video grid and the steps. All content should be editable via the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-setup-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_spacing }}px 20px;
  }

  .ai-setup-section-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-setup-section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    margin-bottom: {{ block.settings.title_spacing }}px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.section_title_alignment }};
  }

  .ai-video-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.videos_per_row_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-video-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.videos_per_row_mobile }}, 1fr);
    }
  }

  .ai-video-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: {{ block.settings.video_placeholder_bg }};
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-video-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-video-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-steps-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.step_spacing }}px;
  }

  .ai-step-item-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.step_number_gap }}px;
    align-items: flex-start;
  }

  .ai-step-number-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.step_number_size }}px;
    height: {{ block.settings.step_number_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.step_number_bg }};
    color: {{ block.settings.step_number_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.step_number_font_size }}px;
    font-weight: 700;
  }

  .ai-step-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-step-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px 0;
  }

  .ai-step-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_body_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-divider-{{ ai_gen_id }} {
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    border: none;
    margin: {{ block.settings.section_spacing }}px 0;
  }
{% endstyle %}

<setup-page-{{ ai_gen_id }} class="ai-setup-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.video_section_title != blank %}
    <div class="ai-setup-section-{{ ai_gen_id }}">
      <h2 class="ai-setup-section-title-{{ ai_gen_id }}">{{ block.settings.video_section_title }}</h2>
      
      <div class="ai-video-grid-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign video_title_key = 'video_' | append: i | append: '_title'
            assign video_desc_key = 'video_' | append: i | append: '_description'
            assign video_title = block.settings[video_title_key]
            assign video_desc = block.settings[video_desc_key]
          %}
          
          {% if video_title != blank %}
            <div class="ai-video-card-{{ ai_gen_id }}">
              <div class="ai-video-placeholder-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <h3 class="ai-video-card-title-{{ ai_gen_id }}">{{ video_title }}</h3>
              {% if video_desc != blank %}
                <p class="ai-video-card-description-{{ ai_gen_id }}">{{ video_desc }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_divider %}
    <hr class="ai-divider-{{ ai_gen_id }}">
  {% endif %}

  {% if block.settings.steps_section_title != blank %}
    <div class="ai-setup-section-{{ ai_gen_id }}">
      <h2 class="ai-setup-section-title-{{ ai_gen_id }}">{{ block.settings.steps_section_title }}</h2>
      
      <div class="ai-steps-container-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% liquid
            assign step_heading_key = 'step_' | append: i | append: '_heading'
            assign step_body_key = 'step_' | append: i | append: '_body'
            assign step_heading = block.settings[step_heading_key]
            assign step_body = block.settings[step_body_key]
          %}
          
          {% if step_heading != blank %}
            <div class="ai-step-item-{{ ai_gen_id }}">
              <div class="ai-step-number-{{ ai_gen_id }}">{{ i }}</div>
              <div class="ai-step-content-{{ ai_gen_id }}">
                <h3 class="ai-step-heading-{{ ai_gen_id }}">{{ step_heading }}</h3>
                {% if step_body != blank %}
                  <div class="ai-step-body-{{ ai_gen_id }}">{{ step_body }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</setup-page-{{ ai_gen_id }}>

<script>
  (function() {
    class SetupPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('setup-page-{{ ai_gen_id }}', SetupPage{{ ai_gen_id }});
  })();
</script>

