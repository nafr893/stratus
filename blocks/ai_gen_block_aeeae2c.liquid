{% doc %}
  @prompt
    Create a block for the Set Up page that displays a downloadable PDF link. The block should include a setting to upload a PDF file and a setting for the link label/text, styled to match the page's existing content.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pdf-link-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #000000;
  }

  .ai-pdf-link-{{ ai_gen_id }}__anchor {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 12px 18px;
    border: 1px solid #000000;
    border-radius: 0;
    color: #000000;
    background-color: transparent;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .ai-pdf-link-{{ ai_gen_id }}__anchor:hover {
    color: #ffffff;
    background-color: #000000;
  }

  .ai-pdf-link-{{ ai_gen_id }}__anchor:focus-visible {
    outline: 2px solid #000000;
    outline-offset: 3px;
  }

  .ai-pdf-link-{{ ai_gen_id }}__icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
  }

  .ai-pdf-link-{{ ai_gen_id }}__icon svg {
    width: 100%;
    height: 100%;
  }

  .ai-pdf-link-{{ ai_gen_id }}__empty {
    margin: 0;
    color: #00000099;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-pdf-link-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-pdf-link-{{ ai_gen_id }}__anchor {
      width: 100%;
      justify-content: center;
    }
  }
{% endstyle %}

<div class="ai-pdf-link-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.pdf_url != blank %}
    <a
      class="ai-pdf-link-{{ ai_gen_id }}__anchor"
      href="{{ block.settings.pdf_url }}"
      target="_blank"
      rel="noopener noreferrer"
      download
      aria-label="{{ block.settings.link_label | escape }}"
    >
      <span class="ai-pdf-link-{{ ai_gen_id }}__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 3V15M12 15L7.5 10.5M12 15L16.5 10.5M4 20.5H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span>{{ block.settings.link_label | escape }}</span>
    </a>
  {% else %}
    <p class="ai-pdf-link-{{ ai_gen_id }}__empty">Add a PDF file URL to display the download link.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "PDF download link",
  "settings": [
    {
      "type": "url",
      "id": "pdf_url",
      "label": "PDF file URL"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Download the setup guide"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "PDF download link"
    }
  ],
  "tag": null,
  "class": "pdf-download-link-block"
}
{% endschema %}